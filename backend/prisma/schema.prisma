generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum FishermanStatus {
  active
  inactive
}

enum BoatStatus {
  available
  at_sea
  maintenance
}

enum SaleStatus {
  pending
  paid
  cancelled
}

enum SaleChannel {
  export
  local
  wholesale
}

enum MaintenanceType {
  routine
  repair
  inspection
  emergency
}

enum ExportStatus {
  preparing
  shipped
  delivered
  cancelled
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  fullName     String
  role         Role           @default(OPERATOR)
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Fisherman {
  id            String          @id @default(cuid())
  fullName      String
  email         String?
  phone         String?
  licenseNumber String?         @unique
  boatId        String?
  boat          Boat?           @relation(fields: [boatId], references: [id], onDelete: SetNull)
  status        FishermanStatus @default(active)
  catches       Catch[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Boat {
  id                 String        @id @default(cuid())
  name               String
  registrationNumber String        @unique
  captain            String?
  capacityKg         Int?
  status             BoatStatus    @default(available)
  fishermen          Fisherman[]
  catches            Catch[]
  maintenances       Maintenance[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Catch {
  id          String    @id @default(cuid())
  boatId      String
  boat        Boat      @relation(fields: [boatId], references: [id], onDelete: Cascade)
  fishermanId String
  fisherman   Fisherman @relation(fields: [fishermanId], references: [id], onDelete: Cascade)
  fishType    String
  weightKg    Float
  quantity    Int       @default(0)
  zone        String?
  lat         Float?
  lng         Float?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([boatId])
  @@index([fishermanId])
  @@index([date])
}

model StockItem {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  species      String?
  warehouse    String?
  quantityKg   Float    @default(0)
  thresholdKg  Float    @default(0)
  unitPrice    Float    @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Sale {
  id         String      @id @default(cuid())
  invoiceNo  String      @unique
  customer   String
  channel    SaleChannel @default(local)
  status     SaleStatus  @default(pending)
  amount     Float
  currency   String      @default("EUR")
  issuedAt   DateTime    @default(now())
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([issuedAt])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  region    String?
  rating    Float      @default(0)
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Purchase {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  species    String
  quantityKg Float
  unitPrice  Float
  total      Float
  date       DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  @@index([supplierId])
  @@index([date])
}

model Export {
  id          String       @id @default(cuid())
  reference   String       @unique
  country     String
  customer    String
  product     String
  quantityKg  Float
  amount      Float
  currency    String       @default("EUR")
  status      ExportStatus @default(preparing)
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model Maintenance {
  id          String          @id @default(cuid())
  boatId      String
  boat        Boat            @relation(fields: [boatId], references: [id], onDelete: Cascade)
  type        MaintenanceType @default(routine)
  description String
  cost        Float           @default(0)
  performedAt DateTime        @default(now())
  nextDueAt   DateTime?
  createdAt   DateTime        @default(now())

  @@index([boatId])
}
